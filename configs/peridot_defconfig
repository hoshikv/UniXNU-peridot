# Kernel configuration of the peridot image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_ARMVIRT_PLATFORM=n

# Source-storage UFS root probe: the original IOStorageFamily/APFS come from the
# prelinked kernelcache, while the UFS transport and owner policy runtime are built
# from source into a separate archive.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/sheng-source-storage/libShengSourceStorage.a"
CONFIG_XNU_SOURCE_STORAGE=y
# Peridot does not select the sheng board diagnostics that own the GPU/HID/IPC rings.
CONFIG_XNU_SOURCE_STORAGE_DIAG=n
CONFIG_XNU_SOURCE_STORAGE_TABLES="userdata"
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
# Placeholder until the peridot Data seed exists.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="2A5E9027-D9E1-40F9-983C-41BD3F1994F5"

CONFIG_XNU_PERIDOT_TOUCH=y
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y

CONFIG_XNU_NATIVE_ADRENO=n
