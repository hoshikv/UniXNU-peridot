-	b		.
+	b		Lloader_early_exception
 	/* EL0 32 */
 	.align	7
-	b		.
+	b		Lloader_early_exception
 	.align	7
-	b		.
+	b		Lloader_early_exception
 	.align	7
-	b		.
+	b		Lloader_early_exception
 	.align	7
-	b		.
+	b		Lloader_early_exception
+
+/*
+ * Early-boot exceptions used to spin here.  When the loader has patched
+ * the address of its return stub into the slot below, report the exception
+ * to it instead (see loader_return.c):
+ *   x0/x1 = PA/length of the captured kernel log, x2 = 1 (early exception),
+ *   x3 = ESR, x4 = ELR, x5 = FAR, x6 = LR, x7 = SP
+ */
+	.align	3
+Lloader_early_exception:
+	mov		x6, lr
+	mov		x7, sp
+	mrs		x3, ESR_EL1
+	mrs		x4, ELR_EL1
+	mrs		x5, FAR_EL1
+	adrp	x0, EXT(loader_log)@page
+	add		x0, x0, EXT(loader_log)@pageoff
+	adrp	x1, EXT(loader_log_len)@page
+	add		x1, x1, EXT(loader_log_len)@pageoff
+	ldr		w1, [x1]
+	/* Write the log back to RAM: dirty lines are lost once the MMU is off. */
+	mov		x9, x0
+	add		x10, x0, x1
+1:
+	dc		cvac, x9
+	add		x9, x9, #64
+	cmp		x9, x10
+	b.lo	1b
+	dsb		sy
+	mov		x2, #1
+	mrs		x9, SCTLR_EL1
+	bic		x9, x9, #1
+	msr		SCTLR_EL1, x9
+	isb
+	adr		x9, Lloader_stub_slot
+	ldr		x9, [x9, #8]
+	cbz		x9, .
+	br		x9
+	.align	3
+	.globl	EXT(loader_stub_slot)
+LEXT(loader_stub_slot)
+Lloader_stub_slot:
+	.ascii	"XNULDRST"				// magic the loader searches for
+	.quad	0						// PA of the loader's return stub
+	.quad	0						// checkpoint number to stop at (0 = none)
+	.quad	0						// (physical - virtual) offset of the kernel
 	.align 12, 0
 
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR) || defined(KERNEL_INTEGRITY_PV_CTRR)
@@ -458,6 +504,31 @@ start_cpu:
 2:
 .endmacro
 
+/*
+ * LOADER_CHECKPOINT n
+ *   Bring-up aid: if the loader asked to stop at checkpoint n, return to it
+ *   right here (reason 2, code n).  Usable with the MMU off or on (V=P).
+ *   Clobbers x0-x3, x9-x11.
+ */
+.macro LOADER_CHECKPOINT
+	adrp	x9, EXT(loader_stub_slot)@page
+	add		x9, x9, EXT(loader_stub_slot)@pageoff
+	ldr		x10, [x9, #16]
+	cmp		x10, #$0
+	b.ne	1f
+	mov		x0, #0
+	mov		x1, #0
+	mov		x2, #2
+	mov		x3, #$0
+	mrs		x11, SCTLR_EL1
+	bic		x11, x11, #1
+	msr		SCTLR_EL1, x11
+	isb
+	ldr		x9, [x9, #8]
+	br		x9
+1:
+.endmacro
+
 /*
  * _start_first_cpu
  * Cold boot init routine.  Called from __start
@@ -467,18 +538,21 @@ start_cpu:
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
-	// Unlock the core for debugging
-	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
 
 	mov		x20, x0
 	mov		x21, #0
+	LOADER_CHECKPOINT 1
 
-	// Set low reset vector before attempting any loads
+	// Set low reset vector before attempting anything that might trap
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
 	MSR_VBAR_EL1_X0
 
+	// Unlock the core for debugging
+	msr		OSLAR_EL1, xzr
+	LOADER_CHECKPOINT 2
+
 
 	// Get the kernel memory parameters from the boot args
 	ldr		x22, [x20, BA_VIRT_BASE]			// Get the kernel virt base
@@ -623,6 +697,7 @@ Lkernelcache_base_found:
 	/* Ensure TTEs are visible */
 	dsb		ish
 
+	LOADER_CHECKPOINT 3
 
 	b		common_start
 
@@ -747,10 +822,17 @@ common_start:
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
 #endif /* HAS_APPLE_PAC */
 
+	cbnz	x21, 2f								// boot CPU cold start only
+	LOADER_CHECKPOINT 4
+2:
 	// Enable caches, MMU, ROP and JOP
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
+	cbnz	x21, 3f
