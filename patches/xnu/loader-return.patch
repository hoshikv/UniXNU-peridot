 	.align	7
-	b		.
+	b		Lloader_early_exception
 	.align	7
-	b		.
+	b		Lloader_early_exception
 	/* EL1 SP1 */
 	.align	7
-	b		.
+	b		Lloader_early_exception
 	.align	7
-	b		.
