diff --git a/osfmk/arm64/loader_return.c b/osfmk/arm64/loader_return.c
new file mode 100644
index 0000000..68b7f78
--- /dev/null
+++ b/osfmk/arm64/loader_return.c
@@ -0,0 +1,267 @@
+/*
+ * Return-to-loader debug channel.
+ *
+ * DarwinBoot leaves UEFI resident and starts this kernel on a secondary CPU.
+ * The loader publishes the physical address of its return stub in
+ * loader_stub_slot (see start.s).  When the kernel is done, panics, or the
+ * host asks it to stop, it cleans its log back to RAM, maps the stub 1:1 and
+ * jumps to it.  The stub switches the MMU off and returns the log to the
+ * waiting UEFI core, which serves it over fastboot.
+ */
+#include <mach/mach_types.h>
+#include <mach/mach_time.h>
+#include <machine/atomic.h>
+#include <kern/debug.h>
+#include <kern/startup.h>
+#include <kern/thread_call.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <arm64/proc_reg.h>
+
+#define LOADER_LOG_SIZE (1024 * 1024)
+
+/* Also referenced from the early exception vector in start.s. */
+char     loader_log[LOADER_LOG_SIZE];
+uint32_t loader_log_len;
+
+static bool loader_return_entered;
+
+/* One L1 table and one L2 table map a single 2 MB block around the stub. */
+static uint64_t loader_l1[512] __attribute__((aligned(4096)));
+static uint64_t loader_l2[512] __attribute__((aligned(4096)));
+
+static uint32_t loader_log_lock;
+
+static void
+loader_log_put_locked(char c)
+{
+	if (loader_log_len < LOADER_LOG_SIZE) {
+		loader_log[loader_log_len++] = c;
+	}
+}
+
+void
+loader_log_putc(char c)
+{
+	uint64_t daif;
+	bool locked = false;
+
+	if (c == '\r') {
+		return;
+	}
+	daif = __builtin_arm_rsr64("DAIF");
+	__builtin_arm_wsr("DAIFSet", DAIFSC_IRQF | DAIFSC_FIQF);
+	for (uint32_t tries = 0; !locked && tries < 10000000; tries++) {
+		locked = os_atomic_cmpxchg(&loader_log_lock, 0, 1, acquire);
+	}
+	loader_log_put_locked(c);
+	if (locked) {
+		os_atomic_store(&loader_log_lock, 0, release);
+	}
+	__builtin_arm_wsr64("DAIF", daif);
+}
+
+static void
+loader_log_puts(const char *s)
+{
+	for (; *s != 0; s++) {
+		loader_log_putc(*s);
+	}
+}
+
+/* Patched by the loader: { magic, PA of return stub, checkpoint, PA - VA }. */
+extern uint64_t loader_stub_slot[4];
+
+struct loader_live {
+	uint64_t magic;                 /* "XNULIVE!" */
+	uint64_t heartbeat;             /* incremented once a second */
+	const char *log;                /* loader_log */
+	const uint32_t *log_len;        /* bytes used */
+	uint64_t reason;
+	volatile uint64_t stop;         /* the loader asks for the run to end */
+	uint64_t reserved[10];
+};
+
+struct loader_live loader_live = {
+	.magic = 0x214556494c554e58ULL,
+	.log = loader_log,
+	.log_len = &loader_log_len,
+};
+
+/* Valid from the first instruction of C code: does not need gVirtBase. */
+static inline uint64_t
+static_kvtophys(const void *va)
+{
+	return (uint64_t)va + loader_stub_slot[3];
+}
+
+/*
+ * Jump to the loader's return stub.  reason: 0 = orderly end, 2 = checkpoint.
+ * Returns only if no loader is listening.
+ */
+static void
+loader_jump(uint64_t reason, uint64_t code)
+{
+#if ARM_PGSHIFT == 12
+	uint64_t stub = loader_stub_slot[1];
+	uint64_t tcr, t0sz;
+
+	if (stub == 0 || loader_return_entered) {
+		return;
+	}
+
+	tcr = __builtin_arm_rsr64("TCR_EL1");
+	t0sz = tcr & 0x3f;
+	/* The TTBR0 walk must start at L1 (1 GB per entry) and reach the stub. */
+	if (t0sz < 25 || t0sz > 33 || (stub >> (64 - t0sz)) != 0) {
+		return;
+	}
+	loader_return_entered = true;
+
+	loader_l1[stub >> 30] = static_kvtophys(loader_l2) |
+	    ARM_TTE_TYPE_TABLE | ARM_TTE_VALID;
+	loader_l2[(stub >> 21) & 0x1ff] = (stub & ~0x1fffffULL) |
+	    ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK | ARM_TTE_BLOCK_AF |
+	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_AP(AP_RWNA) |
+	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITEBACK);
+
+	/*
+	 * The stub turns the MMU off; dirty cache lines do not survive that.
+	 * Write the log back to RAM first.
+	 */
+	for (uintptr_t p = (uintptr_t)loader_log & ~63UL;
+	    p < (uintptr_t)loader_log + loader_log_len; p += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r" (p));
+	}
+	__asm__ volatile ("dsb sy");
+
+	register uint64_t r_ttbr0 __asm__("x0") = static_kvtophys(loader_l1);
+	register uint64_t r_log __asm__("x2") = static_kvtophys(loader_log);
+	register uint64_t r_len __asm__("x3") = loader_log_len;
+	register uint64_t r_tcr __asm__("x4") = tcr;
+	register uint64_t r_stub __asm__("x5") = stub;
+	register uint64_t r_reason __asm__("x6") = reason;
+	register uint64_t r_code __asm__("x7") = code;
+
+	__asm__ volatile (
+		"msr DAIFSet, #0xf\n"
+		"bic x4, x4, #0x80\n"           /* TCR_EL1.EPD0: allow TTBR0 walks */
+		"msr TCR_EL1, x4\n"
+		"msr TTBR0_EL1, x0\n"
+		"isb\n"
+		"tlbi vmalle1\n"
+		"dsb sy\n"
+		"isb\n"
+		"mov x0, x2\n"
+		"mov x1, x3\n"
+		"mov x2, x6\n"
+		"mov x3, x7\n"
+		"br x5\n"
+		: : "r" (r_ttbr0), "r" (r_log), "r" (r_len), "r" (r_tcr),
+		"r" (r_stub), "r" (r_reason), "r" (r_code));
+	__builtin_unreachable();
+#else
+	(void)reason;
+	(void)code;
+#endif /* ARM_PGSHIFT == 12 */
+}
+
+extern char *debug_buf_base, *debug_buf_ptr;
+
+struct loader_msgbuf {
+	int   msg_magic;
+	int   msg_size;
+	int   msg_bufx;
+	int   msg_bufr;
+	char *msg_bufc;
+};
+extern struct loader_msgbuf *msgbufp;
+
+static void
+loader_log_append_msgbuf(void)
+{
+	struct loader_msgbuf *mb = msgbufp;
+
+	if (mb == NULL || mb->msg_bufc == NULL || mb->msg_size <= 0 ||
+	    mb->msg_bufx < 0 || mb->msg_bufx > mb->msg_size) {
+		return;
+	}
+	loader_log_puts("\n--- kernel message buffer ---\n");
+	for (int pass = 0; pass < 2; pass++) {
+		int from = pass == 0 ? mb->msg_bufx : 0;
+		int to = pass == 0 ? mb->msg_size : mb->msg_bufx;
+		for (int i = from; i < to; i++) {
+			if (mb->msg_bufc[i] != 0) {
+				loader_log_putc(mb->msg_bufc[i]);
+			}
+		}
+	}
+}
+
+void
+loader_return(void)
+{
+	if (!loader_return_entered) {
+		loader_log_append_msgbuf();
+	}
+	if (!loader_return_entered && debug_buf_base != NULL &&
+	    debug_buf_ptr > debug_buf_base &&
+	    (size_t)(debug_buf_ptr - debug_buf_base) < 256 * 1024) {
+		loader_log_puts("\n--- panic buffer ---\n");
+		for (const char *c = debug_buf_base; c < debug_buf_ptr; c++) {
+			loader_log_putc(*c);
+		}
+	}
+	loader_jump(0, 0);
+}
+
+void
+loader_checkpoint(uint64_t n)
+{
+	if (loader_stub_slot[2] == n) {
+		loader_jump(2, n);
+	}
+}
+
+static thread_call_t loader_watch_call;
+static uint64_t loader_return_deadline;
+static uint32_t loader_return_after;
+
+static void
+loader_watch(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	uint64_t deadline;
+
+	if (loader_live.stop) {
+		loader_log_puts("\n--- the host asked for the end of the run ---\n");
+		loader_return();
+	}
+	loader_live.heartbeat++;
+	if (loader_return_after != 0 && mach_absolute_time() >= loader_return_deadline) {
+		loader_log_puts("\n--- loader_return_after expired ---\n");
+		loader_return();
+	}
+	clock_interval_to_deadline(1, NSEC_PER_SEC, &deadline);
+	thread_call_enter_delayed(loader_watch_call, deadline);
+}
+
+__startup_func
+static void
+loader_watch_init(void)
+{
+	uint32_t enabled = 0;
+
+	if (!PE_parse_boot_argn("fastbootdebug", &enabled, sizeof(enabled)) || enabled == 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("loader_return_after", &loader_return_after,
+	    sizeof(loader_return_after)) && loader_return_after != 0) {
+		clock_interval_to_deadline(loader_return_after, NSEC_PER_SEC,
+		    &loader_return_deadline);
+	}
+	loader_watch_call = thread_call_allocate(loader_watch, NULL);
+	if (loader_watch_call != NULL) {
+		loader_watch(NULL, NULL);
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, loader_watch_init);
